# ==========================================================================
# Backend (.env.example) — copy to .env and fill in real values.
# NEVER put real secrets in this file; .env must stay git-ignored.
# Vars marked [PROD-REQUIRED] make the server fail-fast (refuse to boot) in
# production if unset — see src/config/env.ts.
# ==========================================================================

# --- Server ---------------------------------------------------------------
PORT=3000
# F-06: "production" => session cookie set with Secure + SameSite=None (needs HTTPS).
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Mongoose connection string. Use your own cluster / a local mongod.
MONGO_URI=mongodb://localhost:27017/p2p-escrow

# --- Blockchain / signing -------------------------------------------------
# Chain ID: 31337 for local Anvil, 56 for BSC mainnet
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# On-chain signer used by BlockchainService (P2P escrow owner ops, etc.).
# C4/H4: keep OUT of git; rotate if exposed; prefer a multisig for escrow ownership.
PRIVATE_KEY=YOUR_PRIVATE_KEY
THIRDWEB_CLIENT_ID=YOUR_THIRDWEB_CLIENT_ID
THIRDWEB_SECRET_KEY=YOUR_THIRDWEB_SECRET_KEY

# --- Auth & sessions ------------------------------------------------------
# C2: [PROD-REQUIRED] Server refuses to boot if missing, < 32 chars, or a known
# placeholder (change_me / default_secret_key_change_me / secret).
# Generate a strong one: openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32_output
# C2: token lifetime (default 5d).
JWT_EXPIRES_IN=5d
# F-06: credentialed CORS allowlist (frontend + admin panel). No wildcard allowed.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# F-06: session-cookie lifetime in ms (optional, default 5 days).
# COOKIE_MAX_AGE_MS=432000000

# --- SIWE wallet login (F-07) ---------------------------------------------
# Optional explicit SIWE message domain (host only, no scheme). If unset, the
# hosts of CORS_ORIGINS are accepted automatically — set this only to allow an
# extra domain beyond the CORS allowlist (include both apex and www in prod).
# SIWE_DOMAIN=app.amerox.io
# Optional: how long an issued login nonce stays valid, in ms (default 5 min).
# NONCE_TTL_MS=300000

# --- Internal service auth (M4) -------------------------------------------
# [PROD-REQUIRED] Shared secret guarding POST /api/user/referral/first-trade.
# Callers (limit_order_backend, copy_trading_engine) must send it as the
# `X-Internal-Key` header with this exact value. Generate: openssl rand -hex 32
INTERNAL_SERVICE_KEY=replace_with_openssl_rand_hex_32_output

# --- KYC / Sumsub (H6) ----------------------------------------------------
# All come from the Sumsub dashboard. KYC is silently broken until these are set.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=YOUR_SUMSUB_APP_TOKEN
SUMSUB_SECRET_KEY=YOUR_SUMSUB_SECRET_KEY
SUMSUB_LEVEL_NAME=basic-kyc-level
# H6: [PROD-REQUIRED] HMAC secret for webhook signature verification. Must match
# the value configured in Sumsub (Webhooks -> Secret). The webhook rejects every
# request (401) when this is unset, and the server won't boot in production.
SUMSUB_WEBHOOK_SECRET=YOUR_SUMSUB_WEBHOOK_SECRET

# --- Contract addresses ---------------------------------------------------
# These are deployment-specific (Anvil deterministic defaults shown) — replace
# with the addresses printed by your deploy scripts, and keep them in sync with
# the ABIs (see the security findings "redeploy" note).
#
# P2P escrow (code reads CONTRACT_ADDRESS and/or P2P_CONTRACT_ADDRESS):
CONTRACT_ADDRESS=0xB7f8BC63BbcaD18155201308C8f3540b07f84F5e
P2P_CONTRACT_ADDRESS=0xB7f8BC63BbcaD18155201308C8f3540b07f84F5e
# Optional separate RPC for the P2P listener (falls back to RPC_URL if unset):
P2P_RPC_URL=http://127.0.0.1:8545
#
# Perpetuals (new_perp):
PERP_MARKET_ADDRESS=0x18998c7E38ede4dF09cEec08E5372Bf8fe5719ea
PERP_ROUTER_ADDRESS=
PERP_POSITION_MANAGER_ADDRESS=
#
# Copy trading:
COPY_TRADING_FACTORY_ADDRESS=
#
# VITE_* fallbacks some services read (mirror the addresses above):
VITE_P2P_CONTRACT=0xB7f8BC63BbcaD18155201308C8f3540b07f84F5e
VITE_PERP_MARKET_ADDRESS=0x18998c7E38ede4dF09cEec08E5372Bf8fe5719ea
VITE_PERP_MARKET_BTC_ADDRESS=
