# ============================================
# Perpetual Futures Deployment - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp env.example .env

# ============================================
# REQUIRED FOR DeployPerpetualAll.s.sol
# ============================================

# Your existing mock token address (to use as USDC)
# This is REQUIRED - you must have this token deployed already
USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Backend operator wallet address
# This is the address that will execute trades on behalf of users
# Get this from: address derived from OPERATOR_PRIVATE_KEY in backend .env
# If not set, will use deployer address (for testing only)
OPERATOR_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# ============================================
# OPTIONAL FOR DeployPerpetualAll.s.sol
# ============================================

# Private key for deployment (default: Anvil account #0 for local testing)
# WARNING: Never commit this to git! Use a .gitignore
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Initial price for index token (default: $2000)
# Format: Price in 1e18 (e.g., $2000 = 2000000000000000000000)
INITIAL_PRICE=2000000000000000000000

# Whether to deploy a new index token (true) or use existing (false)
# If false, INDEX_TOKEN_ADDRESS must be set
DEPLOY_INDEX_TOKEN=false

# Index token address (REQUIRED if DEPLOY_INDEX_TOKEN=false)
# This is the token you're trading perpetuals for (e.g., ETH, BTC)
# If DEPLOY_INDEX_TOKEN=true, this will be ignored and a new token will be deployed
INDEX_TOKEN_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# ============================================
# FOR DeployPerpetual.s.sol (standalone deployment)
# ============================================
# Requires:
# - PRIVATE_KEY (optional)
# - USDC_ADDRESS (required)
# - ORACLE_ADDRESS (required - from MockOracle deployment)
# - INDEX_TOKEN_ADDRESS (required)
# - OPERATOR_ADDRESS (optional)

# ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================
# FOR SetOraclePrice.s.sol (update price)
# ============================================
# Requires:
# - PRIVATE_KEY (optional)
# - ORACLE_ADDRESS (required)
# - INDEX_TOKEN_ADDRESS (required)
# - INITIAL_PRICE (this is the NEW price to set)

# ============================================
# PRICE REFERENCE GUIDE
# ============================================
# All prices are in 1e18 format
# 
# $1000   = 1000000000000000000000  (1000 * 1e18)
# $2000   = 2000000000000000000000  (2000 * 1e18)
# $2500   = 2500000000000000000000  (2500 * 1e18)
# $3000   = 3000000000000000000000  (3000 * 1e18)
# $10000  = 10000000000000000000000 (10000 * 1e18)
#
# To calculate: Price * 1e18 = Price * 1000000000000000000

