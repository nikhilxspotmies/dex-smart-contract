# Runtime queries — Supabase transaction-mode pooler (port 6543).
# ?pgbouncer=true is required: without it Prisma sends prepared statements the
# pooler cannot keep, and you get intermittent "prepared statement s0 already
# exists" once two requests overlap.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations only — Supabase session-mode pooler (port 5432).
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
CHAIN_ID=31337
PORT=3001
LIMIT_ORDER_ADDRESS=0x0B306BF915C4d645ff596e518fAf3F9669b97016
MATCHER_PRIVATE_KEY=YOUR_MATCHER_PRIVATE_KEY

# Optional overrides for the tradeable token list (src/utils/tokenConfig.ts). Unset
# falls back to the BSC mainnet addresses hardcoded there, so these are only needed to
# point the matching engine at another chain's deployment. Keep in step with
# Amerox-dex/.example.env — the two lists must agree or the matcher builds price keys
# the frontend cannot read back.
TOKEN_BTCB_ADDRESS=0x7130d2A12B9BCbFAe4f2634d864A1Ee1Ce3Ead9c
TOKEN_ETH_ADDRESS=0x2170Ed0880ac9A755fd29B2688956BD959F933F8
TOKEN_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
TOKEN_WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
TOKEN_XRP_ADDRESS=0x1D2F0da169ceB9fC7B3144628dB156f3F6c60dBE
TOKEN_USDC_ADDRESS=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
TOKEN_SOL_ADDRESS=0x570A5D26f7765Ecb712C0924E4De545B89fD43dF
TOKEN_TRX_ADDRESS=0xCE7de646e7208a4Ef112cb6ed5038FA6cC6b12e3
TOKEN_DOGE_ADDRESS=0xbA2aE424d960c26247Dd6c32edC70B295c744C43
TOKEN_CAKE_ADDRESS=0x0E09FaBB73Bd3Ade0a17ECC321fD13a19e81cE82
