generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  OPEN
  FILLED
  CANCELLED
}

model Order {
  orderHash    String      @id
  makerAsset   String
  takerAsset   String
  maker        String
  makingAmount String
  takingAmount String
  salt         String
  deadline     Int
  signature    String
  status       OrderStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}
