# ============================================
# PERPETUAL BACKEND CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# 
# IMPORTANT: Do not commit .env to version control!

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3002
CHAIN_ID=31337
RPC_URL=http://localhost:8545

# ============================================
# SHARED CONFIGURATION
# ============================================
# MockOracle contract address (shared across all markets)
MOCK_ORACLE_ADDRESS=0x...

# Operator private key (used to sign transactions)
# This should be the private key of the OPERATOR_ADDRESS set in Perpetual contracts
OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ============================================
# MULTI-MARKET CONFIGURATION (RECOMMENDED)
# ============================================
# Format: MARKET_<SYMBOL>_<PROPERTY>
# Use dashes in symbol: ETH-PERP, BTC-PERP, SOL-PERP
# 
# Example: ETH-PERP market
MARKET_ETH_PERP_INDEX_TOKEN=0x0165878A594ca255338adfa4d48449f69242Eb8F
MARKET_ETH_PERP_CONTRACT=0x...
MARKET_ETH_PERP_NAME=Ethereum Perpetual

# Example: BTC-PERP market
# MARKET_BTC_PERP_INDEX_TOKEN=0x...
# MARKET_BTC_PERP_CONTRACT=0x...
# MARKET_BTC_PERP_NAME=Bitcoin Perpetual

# Example: SOL-PERP market
# MARKET_SOL_PERP_INDEX_TOKEN=0x...
# MARKET_SOL_PERP_CONTRACT=0x...
# MARKET_SOL_PERP_NAME=Solana Perpetual

# Default market (optional - uses first loaded market if not set)
DEFAULT_MARKET=ETH-PERP

# ============================================
# LEGACY SINGLE-MARKET CONFIGURATION
# ============================================
# These are used only if no MARKET_* variables are set
# (For backward compatibility)
PERPETUAL_CONTRACT_ADDRESS=0x...
USDC_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
INDEX_TOKEN_ADDRESS=0x0165878A594ca255338adfa4d48449f69242Eb8F

# ============================================
# NOTES
# ============================================
# 1. Multi-Market Setup:
#    - Use MARKET_<SYMBOL>_* format for each market
#    - Symbol should use dashes: ETH-PERP, BTC-PERP
#    - INDEX_TOKEN is the token address (e.g., ETH token address)
#    - CONTRACT is the deployed Perpetual contract address
#    - NAME is a display name (optional)
#
# 2. Single Market (Legacy):
#    - Use PERPETUAL_CONTRACT_ADDRESS and INDEX_TOKEN_ADDRESS
#    - Automatically creates a default market
#
# 3. Operator Setup:
#    - OPERATOR_PRIVATE_KEY must correspond to the OPERATOR_ADDRESS
#    - used when deploying Perpetual contracts
#    - To get address from private key: cast wallet address --private-key 0x...
#
# 4. Oracle:
#    - MOCK_ORACLE_ADDRESS is shared across all markets
#    - Each market's token price is stored in the same oracle
#    - Use setPrice(tokenAddress, price) to update prices
#
# 5. Adding New Markets:
#    - Deploy a new Perpetual contract
#    - Add MARKET_<SYMBOL>_* entries to this file
#    - Restart the backend
#    - Market will be automatically loaded
