# ============================================
# Perpetual Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Blockchain Configuration
# ============================================
# RPC URL for your blockchain (local or remote)
RPC_URL=http://localhost:8545

# Chain ID (31337 for local Hardhat/Anvil, 11155111 for Sepolia, etc.)
CHAIN_ID=31337

# ============================================
# Contract Addresses
# ============================================
# Address of the deployed Perpetual contract
PERPETUAL_CONTRACT_ADDRESS=

# Address of the deployed MockOracle contract
MOCK_ORACLE_ADDRESS=

# Address of the USDC token (mock token address)
USDC_ADDRESS=

# Address of the index token (e.g., TKA token)
INDEX_TOKEN_ADDRESS=

# ============================================
# Backend Operator Configuration
# ============================================
# Private key of the operator wallet (backend uses this to sign transactions)
# This wallet must be set as the operator in the Perpetual contract
# WARNING: Never commit this to version control!
OPERATOR_PRIVATE_KEY=

# ============================================
# Market Configuration (Optional)
# ============================================
# Default market symbol (e.g., "TKA-PERP", "ETH-PERP")
# If not set, uses the first market from markets.ts
DEFAULT_MARKET=
DEFAULT_MARKET_SYMBOL=

# ============================================
# System LP (Synthetic Liquidity Provider) Configuration
# ============================================
# Enable synthetic LP to act as counterparty for unmatched orders
# Set to "true" to enable, "false" to disable
USE_SYNTHETIC_LP=false

# Address of the System LP wallet
# This wallet should have USDC deposited into the Perpetual contract
# Leave empty if USE_SYNTHETIC_LP is false
SYSTEM_LP_ADDRESS=

# Private key of the System LP wallet (optional, only needed if backend needs to sign as System LP)
# WARNING: Never commit this to version control!
SYSTEM_LP_PRIVATE_KEY=

# ============================================
# Server Configuration
# ============================================
# Port for the backend API server
PORT=3002

# ============================================
# Notes
# ============================================
# 1. To set up System LP:
#    - Run: forge script script/SetupSyntheticLP.s.sol --rpc-url <RPC_URL> --broadcast
#    - The script will output the SYSTEM_LP_ADDRESS
#    - Copy the address to SYSTEM_LP_ADDRESS above
#    - Set USE_SYNTHETIC_LP=true
#
# 2. The OPERATOR_PRIVATE_KEY must correspond to the operator address
#    set in the Perpetual contract deployment
#
# 3. For local development, you can use Hardhat/Anvil default accounts
#    For production, use secure key management

